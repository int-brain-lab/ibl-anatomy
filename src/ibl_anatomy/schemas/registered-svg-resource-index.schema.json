{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.internationalbrainlab.org/schema/v1/registered-svg-resource-index.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "format", "projection_id", "resources"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "format": {"const": "atlas-registered-svg-resource-index-v1"},
    "projection_id": {"enum": ["coronal", "sagittal", "horizontal"]},
    "resources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["pack_id", "slice_indices", "resource"],
        "properties": {
          "pack_id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"},
          "slice_indices": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
          "resource": {"$ref": "common.schema.json#/$defs/encodedResource"}
        }
      }
    }
  }
}
